# Copiar a .env y completar. NO commitear .env.

# Aplicación
APP_NAME=fraud-assistant
APP_ENV=local
LOG_LEVEL=INFO

# LLM (Groq) — usado por el classifier de intents.
# El modelo debe soportar structured outputs estrictos (json_schema strict).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20

# Embeddings / RAG
EMBEDDING_MODEL=
KB_PATH=app/kb
RAG_TOP_K=4
RAG_MIN_SCORE=0.0

# API simulada de bloqueo de tarjetas
MOCK_API_BASE_URL=http://localhost:8001
