# Copiar a .env y completar. NO commitear .env.

# Aplicación
APP_NAME=Centinela
APP_ENV=local
LOG_LEVEL=INFO

# LLM (Groq) — usado por el classifier de intents.
# El modelo debe soportar structured outputs estrictos (json_schema strict).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20

# Embeddings / RAG
# Modelo local de fastembed (ONNX; se descarga de Hugging Face la primera vez)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Prefijos opcionales que exigen algunos modelos (p. ej. intfloat/multilingual-e5-*: "query: " / "passage: ")
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
KB_PATH=app/kb
RAG_TOP_K=4
RAG_MIN_SCORE=0.0

# Opcional: actualmente no se lee en ningún lugar del código; no hace falta configurarla.
# Reservado para una futura integración con el backend transaccional real del banco.
# El MVP simula el bloqueo y el estado de transacción como funciones locales
# en app/api/mock_backend.py (ver LIMITATIONS.md, sección
# "Alcance: backend transaccional simulado (mock)").
MOCK_API_BASE_URL=http://localhost:8001

# Persistencia de conversaciones (SQLite)
DATABASE_PATH=data/chat.db
HISTORY_CONTEXT_MESSAGES=6
