# Copiar a .env y completar. NO commitear .env.

# Aplicación
APP_NAME=fraud-assistant
APP_ENV=local
LOG_LEVEL=INFO

# Proveedor LLM: openai | anthropic (solo se necesita la API key del proveedor elegido)
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings / RAG
EMBEDDING_MODEL=
KB_PATH=app/kb
RAG_TOP_K=4
RAG_MIN_SCORE=0.0

# API simulada de bloqueo de tarjetas
MOCK_API_BASE_URL=http://localhost:8001
